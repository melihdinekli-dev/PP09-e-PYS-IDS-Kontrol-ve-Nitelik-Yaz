        </ids:material>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="IfcRoof Sınıfı Özellikleri" ifcVersion="IFC4X3_ADD2" description="Tanım: Çatı, bir binanın en üst kısmını örten yapı elemanıdı; binayı hava koşullarının etkilerine karşı korur.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCROOF</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>PredefinedType</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="EK-5 Tablo.1 den tanımlandı.">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="[A-Z]{2}-CAT-[^-]+"/>
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Tag</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property cardinality="required" dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>Pset_RoofCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IsExternal</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required" dataType="IFCLABEL" instructions="Bu nesnenin yangın dayanım sınıfı. Ulusal yangın güvenliği sınıflandırmasına göre (Türkiye için: Binaların Yangından Korunması Hakkında Yönetmeliğe göre) verilmiştir.">
          <ids:propertySet>
            <ids:simpleValue>Pset_RoofCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>FireRating</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="IfcSanitaryTerminal Sınıfı Özellikleri" ifcVersion="IFC4X3_ADD2" description="Tanım: Sıhhi terminal, genellikle su ile beslenen ve içme, temizlik veya atık suyun uzaklaştırılması için kullanılan sabit bir cihaz veya terminaldir ya da böyle bir cihaz veya terminal ile doğrudan kullanılan bir ekipman öğesidir.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSANITARYTERMINAL</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>PredefinedType</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="EK-5 Tablo.1 den tanımlandı.">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="MK-STT-[^-]+"/>
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Tag</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="IfcSign Sınıfı Özellikleri" ifcVersion="IFC4X3_ADD2" description="Tanım: Levha (tabela), yazılı, sembolik veya başka bir biçimde bilgi ya da talimat veren görsel bir bildirimdir. Tabelalar pasiftir; en yaygın biçimi görsel panodur. IfcSign örneği,  duvar gibi bir yüzeye uygulanan bir panelin yerleştirilmiş veya bir Sinyal Bileşimi içinde toplanan birden fazla tabela örneği yerleştirilmesini ve ilgili taşıyıcı yapısal elemanlarını ifade eder.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSIGN</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>PredefinedType</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="EK-5 Tablo.1 den tanımlandı.">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="[A-Z]{2}-TBL-[^-]+"/>
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Tag</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="IfcSite Sınıfı Özellikleri" ifcVersion="IFC4X3_ADD2" description="Tanım: Saha, projenin inşaatının gerçekleştirileceği, suyla kaplı olabilecek sınırları belirli bir kara alanıdır. Bir saha, bina inşa etmek, mevcut yapıları yenilemek veya yıkmak ya da diğer inşaatla ilgili geliştirme faaliyetleri için kullanılabilir.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSITE</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>ObjectType</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="EK-5 Tablo.1 den tanımlandı.">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="[A-Z]{2}-SAH-[^-]+"/>
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>RefElevation</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property cardinality="required" dataType="IFCPOSITIVERATIOMEASURE" instructions="Yerel imar yönetmeliklerine (Planlı Alanlar İmar Yönetmeliğine) göre belirlenen, toplam kat alanının yapılaşabilir alana oranı olarak ifade edilen azami kat alanı kullanım oranıdır.">
          <ids:propertySet>
            <ids:simpleValue>Pset_SiteCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>FloorAreaRatio</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required" dataType="IFCPOSITIVERATIOMEASURE" instructions="Kullanım oranı, [[ToplamAlan]] / [[YapılaşabilirAlan]] biçiminde azami bir değer olarak ifade edilir. Bu oran değeri, [[YapılaşabilirAlan]]’ın türetilmesinde kullanılabilir.">
          <ids:propertySet>
            <ids:simpleValue>Pset_SiteCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>SiteCoverageRatio</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required" dataType="IFCAREAMEASURE" instructions="Arsaya ilişkin toplam planlanan alandır. Arsa alanının programlanması amacıyla kullanılır.">
          <ids:propertySet>
            <ids:simpleValue>Pset_SiteCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>TotalArea</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required" instructions="Posta adresidir. NOT: Bir posta adresi kaydedilirken birden fazla satır (veya öğe) içerebilir. Normal kullanımda, aşağıdaki adres kavramlarının ilgili unsurlarını içermesi beklenir: Bina içindeki konum (ör. 3. Kat) Bina adı (ör. Interoperability House) Bina numarası (ör. 6400) Sokak adı (ör. Alliance Boulevard) Adres satırlarının tipik içeriği ülkeden ülkeye değişiklik gösterebilir.">
          <ids:propertySet>
            <ids:simpleValue>Pset_Address</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>AddressLines</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required" dataType="IFCLABEL" instructions="Bir kasaba veya şehrin adıdır.">
          <ids:propertySet>
            <ids:simpleValue>Pset_Address</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Town</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required" dataType="IFCLABEL" instructions="Bir bölge veya ilçenin adıdır.">
          <ids:propertySet>
            <ids:simpleValue>Pset_Address</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Region</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required" dataType="IFCIDENTIFIER" instructions="Yasal tescil makamı tarafından bir taşınmaz parseline atanan kimlik numarasıdır.">
          <ids:propertySet>
            <ids:simpleValue>Pset_LandRegistration</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>LandID</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required" dataType="IFCIDENTIFIER" instructions="Yasal tescil makamı tarafından bir taşınmaz parseline ait tapuya atanan kimlik numarasıdır.">
          <ids:propertySet>
            <ids:simpleValue>Pset_LandRegistration</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>LandTitleID</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required" dataType="IFCREAL" instructions="Taban Alanı Kat Sayısı'nı ifade eder.">
          <ids:propertySet>
            <ids:simpleValue>TREpys_ParselOzellikSeti</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>TAKS</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required" dataType="IFCREAL" instructions="Kat Alanı Kat Sayısı'nı ifade eder.">
          <ids:propertySet>
            <ids:simpleValue>TREpys_ParselOzellikSeti</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>KAKS</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required" dataType="IFCREAL" instructions="Ön bahçe mesafesi: Yapı ile parselin ön sınırı arasındaki yatay uzaklıktır.">
          <ids:propertySet>
            <ids:simpleValue>TREpys_ParselOzellikSeti</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>CekmeOn</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required" dataType="IFCREAL" instructions="Yan bahçe mesafesi: Yapı ile parselin yan sınırları arasındaki yatay uzaklıktır.">
          <ids:propertySet>
            <ids:simpleValue>TREpys_ParselOzellikSeti</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>CekmeYan</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required" dataType="IFCREAL" instructions="Arka bahçe mesafesi: Yapı ile parselin arka sınırı arasındaki yatay uzaklıktır.">
          <ids:propertySet>
            <ids:simpleValue>TREpys_ParselOzellikSeti</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>CekmeArka</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="IfcSlab Sınıfı Özellikleri - Ad Kontrol" ifcVersion="IFC4X3_ADD2" description="Tanım: Döşeme, düşey olarak bir hacmi kapatabilen yapı bileşenidir. Döşeme, alt taşıyıcıyı (kat döşemesi) veya üst katı (çatı döşemesi) sağlayabilir ve bir binadaki herhangi bir mekânda yer alabilir.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSLAB</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required" instructions="EK-5 Tablo.1 den tanımlandı.">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="(MM|IM|PY|AL|ST|ZE)-DSM-[^-]+"/>
            </xs:restriction>
          </ids:value>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="IfcSlab Sınıfı Özellikleri - Yapısal Olmayan" ifcVersion="IFC4X3_ADD2" description="Tanım: Döşeme, düşey olarak bir hacmi kapatabilen yapı bileşenidir. Döşeme, alt taşıyıcıyı (kat döşemesi) veya üst katı (çatı döşemesi) sağlayabilir ve bir binadaki herhangi bir mekânda yer alabilir.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSLAB</ids:simpleValue>
          </ids:name>
        </ids:entity>
        <ids:attribute>
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="(MM|IM|PY)-DSM-[^-]+"/>
            </xs:restriction>
          </ids:value>
        </ids:attribute>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>PredefinedType</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Tag</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property cardinality="required" dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>Pset_SlabCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IsExternal</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required" dataType="IFCLABEL" instructions="Tam sayı olarak dakika bilgisi verilmelidir.">
          <ids:propertySet>
            <ids:simpleValue>Pset_SlabCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>FireRating</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:material cardinality="required"></ids:material>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="IfcSlab Sınıfı Özellikleri - Yapısal" ifcVersion="IFC4X3_ADD2" description="Tanım: Döşeme, düşey olarak bir hacmi kapatabilen yapı bileşenidir. Döşeme, alt taşıyıcıyı (kat döşemesi) veya üst katı (çatı döşemesi) sağlayabilir ve bir binadaki herhangi bir mekânda yer alabilir.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSLAB</ids:simpleValue>
          </ids:name>
        </ids:entity>
        <ids:attribute>
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="(AL|ST|ZE)-DSM-[^-]+"/>
            </xs:restriction>
          </ids:value>
        </ids:attribute>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>PredefinedType</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Tag</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property cardinality="required" dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>Pset_SlabCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IsExternal</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required" dataType="IFCLABEL" instructions="Tam sayı olarak dakika bilgisi verilmelidir.">
          <ids:propertySet>
            <ids:simpleValue>Pset_SlabCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>FireRating</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:material cardinality="required" instructions="&quot;Malzeme İsmi_Dayanım&quot; formatı kullanılmalıdır. (Örnek:Çelik_S355 Beton_C25)">
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*_.*"/>
            </xs:restriction>
          </ids:value>
        </ids:material>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="IfcSolarDevice Sınıfı Özellikleri" ifcVersion="IFC4X3_ADD2" description="Tanım: Güneş enerjisi cihazı, güneş radyasyonunu elektrik akımı veya ısıl enerji gibi diğer enerji türlerine dönüştürür.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSOLARDEVICE</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:partOf relation="IFCRELASSIGNSTOGROUP">
          <ids:entity>
            <ids:name>
              <ids:simpleValue>IFCSYSTEM</ids:simpleValue>
            </ids:name>
          </ids:entity>
        </ids:partOf>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>PredefinedType</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="EK-5 Tablo.1 den tanımlandı.">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="EE-GEC-[^-]+"/>
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Tag</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="IfcSpace Sınıfı Özellikleri" ifcVersion="IFC4X3_ADD2" description="Tanım: Bir mahal, gerçek veya varsayımsal olarak sınırlandırılmış bir alanı veya hacmi temsil eder. Mekanlar, bir bina içinde belirli işlevleri yerine getiren alanlar veya hacimlerdir.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSPACE</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="(K[0-9]{2}|B[0-9]{2})_[\p{Lu}\p{N}]{3}_[0-9]{3}"/>
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:property cardinality="required" dataType="IFCLABEL" instructions="Mahal döşemesi için malzemeyi veya bitişi belirtmek amacıyla kullanılan etiket. Etiket, mahal listesi (room book) bilgileri için kullanılır ve genellikle mahal kaşesinde gösterilir. Malzeme bilgisi, kendi şekil gösterimine ve malzeme atamasına sahip bir IfcCovering (type=FLOORING) nesnesinin bulunmaması durumunda sağlanır. Tutarsızlık halinde IfcCovering elemanlarına atanmış malzeme dikkate alınır.">
          <ids:propertySet>
            <ids:simpleValue>Pset_SpaceCoveringRequirements</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>FloorCovering</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required" dataType="IFCPOSITIVELENGTHMEASURE" instructions="Mahal döşemesine ait malzeme katman(lar)ının kalınlığı. Kalınlık bilgisi, kendi şekil gösterimine sahip bir IfcCovering (type=FLOORING) nesnesinin bulunmaması durumunda sağlanır. Atanmış bir IfcCovering’in geometrik parametreleri ile bu özelliğe bağlı değer arasında tutarsızlık olması durumunda geometrik parametreler dikkate alınır.">
          <ids:propertySet>
            <ids:simpleValue>Pset_SpaceCoveringRequirements</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>FloorCoveringThickness</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required" dataType="IFCLABEL" instructions="Mahal duvar kaplaması için malzeme veya bitişi belirtmek amacıyla kullanılan etiket. Etiket, mahal listesi bilgileri için kullanılır ve genellikle mahal kaşesinde gösterilir. Malzeme bilgisi, kendi şekil gösterimine ve malzeme atamasına sahip bir IfcCovering (type=CLADDING) nesnesinin bulunmaması durumunda sağlanır. Tutarsızlık halinde IfcCovering elemanlarına atanmış malzeme dikkate alınır.">
          <ids:propertySet>
            <ids:simpleValue>Pset_SpaceCoveringRequirements</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>WallCovering</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*_.*"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property cardinality="required" dataType="IFCPOSITIVELENGTHMEASURE" instructions="Mahal duvar kaplamasına ait malzeme katman(lar)ının kalınlığı. Kalınlık bilgisi, kendi şekil gösterimine sahip bir IfcCovering (type=CLADDING) nesnesinin bulunmaması durumunda sağlanır. Atanmış bir IfcCovering’in geometrik parametreleri ile bu özelliğe bağlı değer arasında tutarsızlık olması durumunda geometrik parametreler dikkate alınır.">
          <ids:propertySet>
            <ids:simpleValue>Pset_SpaceCoveringRequirements</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>WallCoveringThickness</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required" dataType="IFCLABEL" instructions="Mahal tavanı için malzeme veya bitişi belirtmek amacıyla kullanılan etiket. Etiket, mahal listesi bilgileri için kullanılır ve genellikle mahal kaşesinde gösterilir. Malzeme bilgisi, kendi şekil gösterimine ve malzeme atamasına sahip bir IfcCovering (type=CEILING) nesnesinin bulunmaması durumunda sağlanır. Tutarsızlık halinde IfcCovering elemanlarına atanmış malzeme dikkate alınır.">
          <ids:propertySet>
            <ids:simpleValue>Pset_SpaceCoveringRequirements</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>CeilingCovering</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*_.*"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property cardinality="required" dataType="IFCPOSITIVELENGTHMEASURE" instructions="Mahal tavanına ait malzeme katman(lar)ının kalınlığı. Kalınlık bilgisi, kendi şekil gösterimine sahip bir IfcCovering (type=CEILING) nesnesinin bulunmaması durumunda sağlanır. Atanmış bir IfcCovering’in geometrik parametreleri ile bu özelliğe bağlı değer arasında tutarsızlık olması durumunda geometrik parametreler dikkate alınır..">
          <ids:propertySet>
            <ids:simpleValue>Pset_SpaceCoveringRequirements</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>CeilingCoveringThickness</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="optional" dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>TREpys_EmsalOzellikSeti</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>EmsalDurumu</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="DAHİL"/>
              <xs:enumeration value="HARİÇ"/>
              <xs:enumeration value="ARTIRIM"/>
              <xs:enumeration value="DİĞER"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="IfcSpaceHeater Sınıfı Özellikleri" ifcVersion="IFC4X3_ADD2" description="Tanım: Mekân ısıtıcıları, sınırlı bir mekânı veya alanı ısıtmak için elektrik, buhar veya sıcak su gibi bir ısıtma kaynağı kullanarak ışınım (radyasyon) ve/veya doğal konveksiyon kombinasyonundan yararlanır. Mekân ısıtıcılarına örnek olarak radyatörler, konvektörler, süpürgelik tipi ısıtıcılar ve kanatlı borulu ısıtıcılar verilebilir.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSPACEHEATER</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:partOf relation="IFCRELASSIGNSTOGROUP">
          <ids:entity>
            <ids:name>
              <ids:simpleValue>IFCSYSTEM</ids:simpleValue>
            </ids:name>
          </ids:entity>
        </ids:partOf>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>PredefinedType</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="EK-5 Tablo.1 den tanımlandı.">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="MK-MIS-[^-]+"/>
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Tag</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property cardinality="required" dataType="IFCPOWERMEASURE" instructions="Üretici tarafından listelenen toplam nominal ısı çıkışı.">
          <ids:propertySet>
            <ids:simpleValue>Pset_SpaceHeaterTypeCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>OutputCapacity</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="IfcSpatialZone Sınıfı Özellikleri Emsal Durumu" ifcVersion="IFC4X3_ADD2" description="Tanım: Mekansal zon, belirli bir işlevsel amaca göre projenin hiyerarşik olmayan ve potansiyel olarak örtüşebilen bir alt bölümlenmedir. Mekânsal zonlar örneğin bir ısı bölgesi, inşaat bölgesi, aydınlatma bölgesi veya kullanılabilir alanı temsil etmek için kullanılabilir. Bir mekansal zon, kendi konumlandırmasına ve biçim (geometri) temsiline sahip olabilir.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSPATIALZONE</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property cardinality="required" dataType="IFCLABEL" instructions="İlgili mekansal zon, emsale dahil alanı temsil etmesi halinde 'DAHIL’, emsal dışı alanı temsil etmesi halinde ‘HARIC’, ilgili idarenin özel imar düzenlemelerine bağlı olarak, emsal artışı alanı temsil etmesi halinde 'DIGER' girilir. DIGER olması durumunda açıklama &quot;Attribute: Description&quot; bölümüne girilir.">
          <ids:propertySet>
            <ids:simpleValue>TREpys_EmsalOzellikSeti</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>EmsalDurumu</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="DAHIL"/>
              <xs:enumeration value="HARIC"/>
              <xs:enumeration value="DIGER"/>
              <xs:enumeration value="DAHİL"/>
              <xs:enumeration value="HARİÇ"/>
              <xs:enumeration value="DİĞER"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="IfcSpatialZone Sınıfı Özellikleri Emsal Turu = Dahil veya Hariç" ifcVersion="IFC4X3_ADD2" description="Tanım: Mekansal zon, belirli bir işlevsel amaca göre projenin hiyerarşik olmayan ve potansiyel olarak örtüşebilen bir alt bölümlenmedir. Mekânsal zonlar örneğin bir ısı bölgesi, inşaat bölgesi, aydınlatma bölgesi veya kullanılabilir alanı temsil etmek için kullanılabilir. Bir mekansal zon, kendi konumlandırmasına ve biçim (geometri) temsiline sahip olabilir.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSPATIALZONE</ids:simpleValue>
          </ids:name>
        </ids:entity>
        <ids:property dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>TREpys_EmsalOzellikSeti</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>EmsalDurumu</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="DAHIL"/>
              <xs:enumeration value="HARIC"/>
              <xs:enumeration value="DAHİL"/>
              <xs:enumeration value="HARİÇ"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="EK-5 Tablo.1 den tanımlandı.">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="[A-Z]{2}-MZN-[^-]+"/>
            </xs:restriction>
          </ids:value>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="IfcSpatialZone Sınıfı Özellikleri Emsal Turu = Diger" ifcVersion="IFC4X3_ADD2" description="Tanım: Mekansal zon, belirli bir işlevsel amaca göre projenin hiyerarşik olmayan ve potansiyel olarak örtüşebilen bir alt bölümlenmedir. Mekânsal zonlar örneğin bir ısı bölgesi, inşaat bölgesi, aydınlatma bölgesi veya kullanılabilir alanı temsil etmek için kullanılabilir. Bir mekansal zon, kendi konumlandırmasına ve biçim (geometri) temsiline sahip olabilir.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSPATIALZONE</ids:simpleValue>
          </ids:name>
        </ids:entity>
        <ids:property dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>TREpys_EmsalOzellikSeti</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>EmsalDurumu</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="DIGER"/>
              <xs:enumeration value="DİĞER"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required" instructions="İlgili mekansal zon, emsale dahil alanı temsil etmesi halinde 'DAHIL’, emsal dışı alanı temsil etmesi halinde ‘HARIC’, ilgili idarenin özel imar düzenlemelerine bağlı olarak, emsal artışı alanı temsil etmesi halinde 'DIGER' girilir. DIGER olması durumunda açıklama &quot;Attribute: Description&quot; bölümüne girilir.">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
