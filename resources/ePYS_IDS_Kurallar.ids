        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="IfcRamp Sınıfı Özellikleri - Yapısal Olmayan" ifcVersion="IFC4X3_ADD2" description="Tanım: Rampa, farklı kotlardaki iki döşeme seviyesini birbirine bağlayan dikey bir geçiş yoludur ve insan dolaşımını sağlar. Ara bir döşeme plağı olarak bir sahanlık içerebilir. Bir rampa normalde basamak içermez.">
