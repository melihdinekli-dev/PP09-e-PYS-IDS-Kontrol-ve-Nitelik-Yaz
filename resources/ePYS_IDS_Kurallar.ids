            </xs:restriction>
          </ids:value>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="IfcHeatExchanger Sınıfı Özellikleri" ifcVersion="IFC4X3_ADD2" description="Tanım: Isı Eşanjörü, plaka veya gövde-boru tipi eşanjörler gibi, birbirine karışmayan ortamlar arasında ısı transferi sağlamak için kullanılan bir cihazdır.">
