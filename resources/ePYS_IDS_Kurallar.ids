          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="[A-Z]{2}-KRK-[^-]+"/>
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Tag</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="IfcRamp Sınıfı Özellikleri - Ad Kontrol" ifcVersion="IFC4X3_ADD2" description="Tanım: Rampa, farklı kotlardaki iki döşeme seviyesini birbirine bağlayan dikey bir geçiş yoludur ve insan dolaşımını sağlar. Ara bir döşeme plağı olarak bir sahanlık içerebilir. Bir rampa normalde basamak içermez.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
