            </xs:restriction>
          </ids:value>
        </ids:material>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="IfcRoadPart Sınıfı Özellikleri" ifcVersion="IFC4X3_ADD2" description="Tanım: Bir yolun parçası.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
