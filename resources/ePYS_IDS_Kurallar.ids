          <ids:name>
            <ids:simpleValue>IFCRAMP</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required" instructions="EK-5 Tablo.1 den tanımlandı.">
