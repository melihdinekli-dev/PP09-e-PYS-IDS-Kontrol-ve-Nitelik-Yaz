    <ids:specification name="IfcChimney Sınıfı Özellikleri" ifcVersion="IFC4X3_ADD2" description="Tanım: Bacalar genellikle bir binanın yapısının dikey ya da dikeye yakın bölümleridir ve bina kabuğunun bir parçasını oluştururlar. Genellikle prefabrik veya yerinde dökme betondan inşa edilirler; günümüzde tuğla ile yapılmaları ise nadirdir.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
