    <ids:specification name="IfcCoil Sınıfı Özellikleri" ifcVersion="IFC4X3_ADD2" description="Tanım: Serpantin, birbirine karışmayan akışkanlar arasında ısı transferi sağlamak için kullanılan bir cihazdır. Yaygın bir örnek, yüzeyi boyunca hareket eden havadan ısıyı uzaklaştırmak için soğutulmuş su, antifriz veya soğutucu akışkan dolaştırılan kanatlı bir serpantinin kullanıldığı soğutma serpantinidir. Bir serpantin, bir ısıtma veya soğutma akışkanı taşıyan bir dizi borunun (serpantin) bir hava akımına yerleştirilmesiyle ısıtma veya soğutma amaçları için kullanılabilir. Serpantin, serpantin formunda demetlenmiş borulardan veya genişletilmiş bir ısı transfer yüzeyi sağlayan kanatlı borulardan yapılabilir.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCCOIL</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:partOf relation="IFCRELASSIGNSTOGROUP">
          <ids:entity>
            <ids:name>
              <ids:simpleValue>IFCSYSTEM</ids:simpleValue>
            </ids:name>
          </ids:entity>
        </ids:partOf>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>PredefinedType</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="EK-5 Tablo.1 den tanımlandı.">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="MK-SRP-[^-]+"/>
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Tag</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property cardinality="required" dataType="IFCPOWERMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_CoilTypeCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>NominalLatentCapacity</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required" dataType="IFCPOWERMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_CoilTypeCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
